# Kopíruj na `rpraxe.env` (mód 600) a doplň hodnoty. Soubor je v .gitignore.
# Hesla se čtou jen při prvním založení účtu — pak žijí v state/users.json.

# --- účty --------------------------------------------------------------
# jméno:role, jméno:role …   role = student | teacher | admin
RPRAXE_USERS=lenka:student,ucitel:teacher
# heslo k účtu <JMÉNO> jako RPRAXE_PASS_<JMÉNO> (malá písmena v proměnné)
RPRAXE_PASS_LENKA=zmen-toto-heslo
RPRAXE_PASS_UCITEL=zmen-toto-heslo

# --- cesty (uvnitř kontejneru, neměň bez důvodu) ------------------------
RPRAXE_DB=/data/state/rpraxe.db
RPRAXE_DATASETS=/data/datasets
RPRAXE_WEB=/srv/web
RPRAXE_TASKS=/srv/tasks
RPRAXE_USER=student

# --- podepisování session cookie ---------------------------------------
# dlouhý náhodný řetězec: openssl rand -hex 32
# RPRAXE_SECRET=

# --- AI vrstva (nepovinné; bez toho funguje vše kromě kouče) ------------
# Poskytovatel: ollama | openai | einfra | anthropic | gemini
# (e-INFRA CZ / MetaCentrum = „einfra"; adresa i modely se dohledají ve správě)
# RPRAXE_PROVIDER=ollama
# RPRAXE_AI_ADRESA=         # adresa API pro jakéhokoli poskytovatele
# Tohle jsou jen VÝCHOZÍ hodnoty. Stejné věci se dají přepnout bez restartu
# v menu Správa → Modely; uloží se do state/config.json (mód 600) a to pak
# má přednost před prostředím. Uživatelé model nevolí — nastavuje ho správce.
# RPRAXE_OLLAMA=http://127.0.0.1:11434   # starší název pro adresu, má přednost RPRAXE_AI_ADRESA
RPRAXE_MODEL=qwen3.5:9b
RPRAXE_MODEL_WRITE=qwen3.6:35b-a3b
RPRAXE_AI_TIMEOUT=60
# RPRAXE_AI_KEY=             # klíč od externího poskytovatele (můžeš zadat i ve správě)

# --- kam se má sandbox vejít --------------------------------------------
# Výchozí chod je JEDEN kontejner: entrypoint v něm spustí runner na localhostu
# a RPRAXE_RUNNER se vůbec nezadává. Vypnutím vestavěného sandboxu
# (RPRAXE_RUNNER_PROMIT=0) řekneš, že běžec běží jinde, a pak je RPRAXE_RUNNER
# povinný — viz docker-compose.dva-slouzby.yml a docs/hosting.md.
# RPRAXE_RUNNER_PROMIT=1
# RPRAXE_SERVE=app           # `runner` = kontejner je jen běžec R
# RPRAXE_RUNNER_INTERNAL_PORT=8081   # port vestavěného běžce uvnitř kontejneru
# RPRAXE_WORK=/work          # dočasné běžiště studentova kódu
# RPRAXE_STATE=/work/state   # uložené R prostředí (pro pokračování v úloze)
# RPRAXE_DATASETS_RO=1       # adresář datasetů je jen pro čtení — ať ho
#                            # entrypoint nezkouší a nehlásí to jako chybu startu
#                            # (dvouslužbová varianta to má takhle záměrně)

# --- limity sandboxu ----------------------------------------------------
RPRAXE_CPU_LIMIT=20
RPRAXE_WALL_LIMIT=30
RPRAXE_MEM_MB=1500
# RPRAXE_SANDBOX_UID=4242
# RPRAXE_SANDBOX_GID=4242

# --- přihlášení přes bránu (SSO, nepovinné) -----------------------------
# viz docs/SSO.md. Bez RPRAXE_SSO_SECRET se hlavičky ignorují.
# RPRAXE_SSO_HEADER=Remote-User
# RPRAXE_SSO_ROLE_HEADER=Remote-Groups
# RPRAXE_SSO_SECRET=spolecne-tajemstvi-brany

# --- zálohy -------------------------------------------------------------
# RPRAXE_BACKUP_DIR=/data/state/backups
# RPRAXE_BACKUP_INFO=/data/state/zaloha.json

# --- ostatní ------------------------------------------------------------
# RPRAXE_AGENT_NOTE=ranní vzkaz nočního agenta, zobrazí se na úvodní obrazovce
# RPRAXE_VERSION=0.3.0
TZ=Europe/Prague
